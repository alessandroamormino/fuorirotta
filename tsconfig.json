{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-comuni-search-test/types/**/*.ts",
    ".next-comuni-search-test/dev/types/**/*.ts",
    ".next-category-taxonomy-test/types/**/*.ts",
    ".next-category-taxonomy-test/dev/types/**/*.ts",
    ".next-region-scoping-test/types/**/*.ts",
    ".next-region-scoping-test/dev/types/**/*.ts",
    ".next-region-coverage-test/types/**/*.ts",
    ".next-region-coverage-test/dev/types/**/*.ts",
    ".next-event-pages-test/types/**/*.ts",
    ".next-event-pages-test/dev/types/**/*.ts",
    ".next-auth-flow-test/types/**/*.ts",
    ".next-auth-flow-test/dev/types/**/*.ts",
    ".next-anon-test/types/**/*.ts",
    ".next-anon-test/dev/types/**/*.ts",
    ".next-saved-flow-test/types/**/*.ts",
    ".next-saved-flow-test/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
