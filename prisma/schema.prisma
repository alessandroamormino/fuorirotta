// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// Prisma 7: il client si genera nel progetto, non piu' in node_modules.
// moduleFormat "cjs" perche' il repository non e' "type": "module" e gli
// script girano con tsx in CommonJS (cron di manutenzione, seed, gate).
generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  moduleFormat = "cjs"
}

// Gli URL non stanno piu' qui: la CLI li legge da prisma.config.ts, il
// client li riceve dall'adapter in lib/prisma.ts.
datasource db {
  provider = "postgresql"
}

model Event {
  id           Int       @id @default(autoincrement())
  source       String    @db.VarChar(50)
  sourceId     String    @map("source_id") @db.VarChar(255)
  title        String    @db.VarChar(500)
  description  String?   @db.Text
  dateStart    DateTime  @map("date_start") @db.Timestamp(6)
  dateEnd      DateTime? @map("date_end") @db.Timestamp(6)
  locationName String?   @map("location_name") @db.VarChar(255)
  address      String?   @db.VarChar(500)
  phone        String?   @db.VarChar(50)
  latitude     Decimal?  @db.Decimal(10, 8)
  longitude    Decimal?  @db.Decimal(11, 8)
  category     String?   @db.VarChar(100)
  // Categoria canonica (Fase 11, D-12): promossa a identita' primaria di
  // categoria, e' cio' su cui ogni lettura filtra e raggruppa; `category`
  // sopra resta il valore grezzo di sorgente, retrocesso a solo dato di
  // provenienza che rende la deriva di mappatura diagnosticabile (D-11).
  // NOT NULL con default a livello di database uguale a FALLBACK_CATEGORY
  // in lib/categories/taxonomy.ts ('Altro'): anche un percorso di scrittura
  // che bypassasse canonicalizeCategory() interamente atterrerebbe dentro
  // la tassonomia invece che su NULL (CAT-04, belt-and-suspenders). Le due
  // stringhe vanno cambiate insieme se mai cambiano.
  canonicalCategory String @default("Altro") @map("canonical_category") @db.VarChar(50)
  sourceUrl    String?   @map("source_url") @db.VarChar(1000)
  imageUrl     String?   @map("image_url") @db.VarChar(1000)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  // Aggancio territoriale (Fase 6, D-01): una sola FK verso Comune, provincia e
  // regione si leggono via join, mai copiate qui. Colonne di sorgente (latitude/
  // longitude sopra) non vengono mai sovrascritte dal backfill (D-14): il punto
  // usato dalla mappa vive in resolvedLatitude/resolvedLongitude, materializzato
  // a scrittura (D-09), con coordinateSource che ne dichiara la provenienza
  // ('source' | 'comune_centroid' | 'geocoded').
  comuneId          Int?     @map("comune_id")
  comune            Comune?  @relation(fields: [comuneId], references: [id])
  resolvedLatitude  Decimal? @map("resolved_latitude") @db.Decimal(10, 8)
  resolvedLongitude Decimal? @map("resolved_longitude") @db.Decimal(11, 8)
  coordinateSource  String?  @map("coordinate_source") @db.VarChar(20)

  // Regione dell'evento (Fase 15, D-03): scritta durante lo scrape
  // (`runRegion` la riceve gia' come argomento, `saveEvents` la scrive su
  // entrambi i rami dell'upsert), MAI derivata a lettura da `comuneId ->
  // comuni.region_name`: 616 eventi futuri su 1.836 (34%, misurato
  // 2026-09-17) non hanno `comuneId`, e con SoloSagre nazionale una singola
  // sorgente servirebbe venti regioni, quindi nemmeno `source` la
  // determina. Nullable di proposito (checkpoint D-03 di 15-01-PLAN.md,
  // opzione `nullable-poi-backfill`): la colonna nasce senza DEFAULT e senza
  // NOT NULL, popolata da `scripts/backfill-region.ts`, idempotente. Il
  // vincolo NOT NULL e' rimandato a una migrazione successiva, solo dopo
  // aver confermato zero righe NULL.
  region            String?  @db.VarChar(50)

  // Deduplica cross-sorgente (Fase 10, D-01/D-04): self-relation opzionale.
  // canonicalEventId nullo significa "riga canonica, oppure mai valutata come
  // duplicato"; valorizzato significa "riga membro che punta al MIN(id) del
  // gruppo". Nessuna riga viene mai cancellata: la fusione si annulla
  // azzerando queste tre colonne. mergeScore e' un punteggio euristico
  // 0.0-1.0 (Float, non Decimal: non serve precisione esatta). mergeReason
  // e' una stringa leggibile (es. "exact;comune=123;date=2026-08-22") che
  // spiega perche' la fusione e' avvenuta, o "no_geo" per le righe senza
  // comuneId (D-07).
  canonicalEventId Int?     @map("canonical_event_id")
  canonicalEvent   Event?   @relation("EventCanonical", fields: [canonicalEventId], references: [id])
  duplicates       Event[]  @relation("EventCanonical")
  savedEvents      SavedEvent[]
  mergeScore       Float?   @map("merge_score")
  mergeReason      String?  @map("merge_reason") @db.VarChar(255)

  @@unique([source, sourceId], name: "events_source_source_id_key")
  @@index([dateStart], name: "idx_events_date_start")
  @@index([latitude, longitude], name: "idx_events_location")
  @@index([category], name: "idx_events_category")
  @@index([canonicalCategory], name: "idx_events_canonical_category")
  @@index([comuneId])
  @@index([canonicalEventId])
  // Fase 15, D-04: la funzione di copertura filtra SEMPRE anche su
  // dateStart (eventi futuri), quindi l'indice e' composito, non su region
  // da sola — altrimenti servirebbe solo meta' della query.
  @@index([region, dateStart], name: "idx_events_region_date_start")
  @@map("events")
}

// Anagrafica territoriale ISTAT (Fase 6): unica fonte di verita' per comune,
// provincia e regione. PK surrogata (D-02): il codice ISTAT contiene le prime
// 3 cifre della provincia e cambia in caso di riassegnazione provinciale, quindi
// non puo' essere la chiave primaria — con una PK surrogata la riassegnazione
// e' un UPDATE su istatCode, non una migrazione delle FK degli eventi.
model Comune {
  id           Int      @id @default(autoincrement())
  istatCode    String   @unique @map("istat_code") @db.VarChar(6)
  name         String   @db.VarChar(255)
  // Nomi alternativi (D-03): bilingue/trilingue (es. Ortisei/St. Ulrich/Urtijei),
  // un array copre tutti i casi senza cambiare schema. Mai null, default vuoto.
  aliases      String[] @default([])
  provinceCode String   @map("province_code") @db.VarChar(10)
  provinceName String   @map("province_name") @db.VarChar(255)
  regionCode   String   @map("region_code") @db.VarChar(10)
  regionName   String   @map("region_name") @db.VarChar(255)
  // Nullable di proposito: l'identita' ISTAT resta autoritativa anche quando la
  // sorgente delle coordinate non copre questo comune. Un comune senza punto
  // resta agganciabile (comuneId valorizzato) ma non produce centroide —
  // comportamento dichiarato, non un NOT NULL che costringerebbe a inventarlo.
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  events Event[]

  @@index([aliases], type: Gin)
  @@map("comuni")
}

model WorkflowExecution {
  id             String    @id @db.Text
  queryHash      String    @unique @map("query_hash") @db.VarChar(64)
  location       String?   @db.VarChar(255)
  radiusKm       Int?      @map("radius_km")
  dateFrom       DateTime? @map("date_from") @db.Date
  dateTo         DateTime? @map("date_to") @db.Date
  cities         String[]  @db.Text
  lastExecutedAt DateTime  @default(now()) @map("last_executed_at") @db.Timestamp(6)
  status         String    @default("pending") @db.VarChar(20)
  eventCount     Int       @default(0) @map("event_count")
  errorMessage   String?   @map("error_message") @db.Text
  n8nExecutionId String?   @map("n8n_execution_id") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([queryHash])
  @@index([lastExecutedAt])
  @@index([status])
  @@map("workflow_executions")
}

model ScrapeRun {
  id         Int      @id @default(autoincrement())
  source     String   @db.VarChar(50)
  region     String   @db.VarChar(50)
  startedAt  DateTime @map("started_at") @db.Timestamp(6)
  durationMs Int      @map("duration_ms")
  eventCount Int      @map("event_count")
  error      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([source, region, startedAt], name: "idx_scrape_runs_source_region_started")
  @@map("scrape_runs")
}

// Lock per regione (D-13, SCHED-03): riga con scadenza, non pg_advisory_lock.
// Un advisory lock e' legato alla sessione fisica Postgres; $queryRaw prende
// in prestito una connessione dal pool di Prisma solo per la durata della
// query, quindi lo sblocco successivo puo' capitare su una connessione
// diversa e diventare un no-op silenzioso. Vedi lib/scrapers/regionLock.ts.
model RegionLock {
  region    String   @id @db.VarChar(50)
  lockedAt  DateTime @map("locked_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@map("region_locks")
}

model MapClusterCache {
  id          String   @id @default("default")
  geojson     Json     // GeoJSON FeatureCollection with all event points
  eventCount  Int      @map("event_count")
  computedAt  DateTime @map("computed_at") @db.Timestamp(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("map_cluster_cache")
}

// Account (Better Auth). Tabelle con prefisso auth_ perche' n8n condivide il
// database Supabase e ha gia' `user` e `auth_identity` (20-PRODUCTION-FACTS.md
// sezione 2): un nome nudo andrebbe in collisione. I NOMI DEI MODELLI restano
// quelli di default della libreria di proposito: l'adapter Prisma chiama
// prisma[modelName], quindi rinominarli lo rompe; si rinominano solo tabelle e
// colonne (@@map/@map).
// User.image e' l'indirizzo della foto del profilo Google (D-20): solo https e
// *.googleusercontent.com, altrimenti NULL; si cancella con l'utente.
// Account.password resta NULL (solo SSO, Fase 20 D-12).
// Le FK verso auth_user sono ON DELETE CASCADE: cancellare l'utente toglie
// sessioni e account senza dipendere dall'ordine di cancellazione (D-10).
model User {
  id            String    @id
  name          String    @db.VarChar(50) // backstop del DB per D-09
  email         String    @unique @db.VarChar(320)
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions      Session[]
  accounts      Account[]
  savedEvents   SavedEvent[]
  calendarFeed  CalendarFeed?
  shareLink     ShareLink?
  follows       UserFollow[]
  preference    UserPreference?

  @@map("auth_user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("auth_verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("auth_rate_limit")
}

// Eventi salvati dall'utente (Fase 22). Ogni riga porta un'ISTANTANEA
// dell'evento (D1, D-01): la riga in `events` viene cancellata 7 giorni dopo
// la fine, mentre l'utente tiene il salvato 12 mesi in "Passati". Le colonne
// dell'istantanea copiano i tipi delle colonne di `events`, cosi' eventDays()
// legge le stesse cifre. event_id e' ON DELETE SET NULL, con il suo indice:
// il purge notturno cancella 500 eventi per lotto e ogni cancellazione cerca
// la colonna. La chiave unica e' (utente, sorgente, id di sorgente) e NON
// (utente, event_id), perche' event_id diventa NULL e due NULL non
// confliggono. user_id cancella a cascata come le altre figlie di auth_user.
model SavedEvent {
  id        Int       @id @default(autoincrement())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   Int?      @map("event_id")
  event     Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  title     String    @db.VarChar(500)
  dateStart DateTime  @map("date_start") @db.Timestamp(6)
  dateEnd   DateTime? @map("date_end") @db.Timestamp(6)
  place     String?   @db.VarChar(255)
  category  String    @map("canonical_category") @db.VarChar(50)
  source    String    @db.VarChar(50)
  sourceId  String    @map("source_id") @db.VarChar(255)
  sourceUrl String?   @map("source_url") @db.VarChar(1000)
  savedAt   DateTime  @default(now()) @map("saved_at") @db.Timestamptz(6)

  @@unique([userId, source, sourceId])
  @@index([eventId])
  @@map("saved_events")
}

// Link del calendario dell'utente (D-11, D-13): una riga per utente. Il
// segreto del link sta in chiaro perche' la finestra mostra lo stesso link a
// ogni apertura, e lo stesso database contiene gia' la lista che il link espone.
model CalendarFeed {
  userId    String    @id @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique @db.VarChar(32)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(6)

  @@map("calendar_feeds")
}

// Link di condivisione della lista salvata (Fase 24). Una riga per utente, quindi
// al piu' un link vivo (D-11). Il codice del link sta in chiaro perche' la finestra
// lo mostra di nuovo al proprietario, come per CalendarFeed. E' un segreto SEPARATO
// da quello del calendario: il testo "Non condividerlo" del feed resta vero. Un link
// morto e' una riga cancellata o sovrascritta, mai un flag (D-11). show_name parte
// spento (D-04). Il nome della tabella resta generico: una lista futura potra'
// portare la visibilita' senza riscrivere i link.
model ShareLink {
  userId    String    @id @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique @db.VarChar(32)
  showName  Boolean   @default(false) @map("show_name")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(6)

  @@map("share_links")
}

// Cosa segue l'utente (Fase 23). Un follow e' una coppia (kind, key): per il
// comune la key e' il codice ISTAT (l'id surrogato differisce fra locale e
// produzione), per la provincia la sigla, per la regione lo slug di
// events.region, per la categoria il nome canonico. La chiave unica
// (utente, kind, key) rende innocuo il doppio tocco e copre anche le ricerche
// per utente. Cascata da auth_user come le altre figlie.
model UserFollow {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @db.VarChar(10)
  key       String   @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, kind, key])
  @@map("user_follows")
}

// Una riga per utente. onboarded_at registra solo che la finestra di
// benvenuto e' stata mostrata, mai un consenso (PREF-03). La Fase 28 aggiunge
// qui le preferenze di notifica. Cascata da auth_user.
model UserPreference {
  userId      String    @id @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboardedAt DateTime? @map("onboarded_at") @db.Timestamptz(6)

  @@map("user_preferences")
}
