{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "scrape": "npx tsx --import ./lib/scrapers/env.ts lib/scrapers/runner.ts",
    "db:dev:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:dev:down": "docker compose -f docker-compose.dev.yml down",
    "db:dev:push": "bash scripts/dev-db.sh npx prisma db push",
    "db:dev:reset": "docker compose -f docker-compose.dev.yml down -v && npm run db:dev:up && npm run db:dev:push",
    "db:dev:psql": "docker compose -f docker-compose.dev.yml exec postgres-dev psql -U fuorirotta -d fuorirotta_dev",
    "db:dev:sql": "docker compose -f docker-compose.dev.yml exec -T postgres-dev psql -U fuorirotta -d fuorirotta_dev -tAc",
    "dev:local": "bash scripts/dev-db.sh npx next dev",
    "scrape:local": "bash scripts/dev-db.sh npx tsx lib/scrapers/runner.ts",
    "seed:comuni": "bash scripts/dev-db.sh npx tsx scripts/seed-comuni.ts",
    "backfill:territorial": "bash scripts/dev-db.sh npx tsx scripts/backfill-events.ts",
    "backfill:categories": "bash scripts/dev-db.sh npx tsx scripts/backfill-categories.ts",
    "backfill:region": "bash scripts/dev-db.sh npx tsx scripts/backfill-region.ts",
    "dedup:events": "bash scripts/dev-db.sh npx tsx scripts/dedup-events.ts",
    "maintenance:local": "bash scripts/dev-db.sh npx tsx scripts/maintenance-job.ts",
    "crontab:generate": "npx tsx scripts/generate-crontab.ts",
    "check:crontab-generate": "bash scripts/crontab-generate.test.sh",
    "check:connection-limit": "npx tsx lib/scrapers/connectionLimit.ts",
    "n1:proof": "bash scripts/dev-db.sh npx tsx scripts/n1-proof.ts",
    "test": "npm run test:ci && npm run test:local",
    "check:tokens": "! grep -rInE '#[0-9a-fA-F]{3,8}\\b' app components lib --include='*.ts' --include='*.tsx' --include='*.css' --exclude='globals.css' | grep -vE '&#[0-9]+;|&#x[0-9a-fA-F]+;'",
    "check:no-regex-parsing": "! grep -nE '\\.(match(All)?|exec)\\(/[^/]*(<|class=)|=\\s*/[^/]*(<|class=)' lib/scrapers/solosagre.ts lib/scrapers/inlombardia.ts lib/scrapers/roma.ts",
    "check:parity": "bash scripts/registry-parity.test.sh",
    "check:monitoring": "bash scripts/monitoring-endpoint.test.sh",
    "check:territorial": "bash scripts/territorial-backfill.test.sh",
    "check:comuni": "bash scripts/comuni-search.test.sh",
    "check:navbar": "bash scripts/navbar-contracts.test.sh",
    "check:dedup": "bash scripts/dedup.test.sh",
    "check:restyle": "bash scripts/visual-restyle.test.sh",
    "check:region-scoping": "bash scripts/region-scoping.test.sh",
    "check:region-lock": "bash scripts/region-lock.test.sh",
    "check:detail-cache": "bash scripts/detail-cache.test.sh",
    "check:browser-bundle": "npx tsx scripts/browser-bundle-safety.ts",
    "check:host-script-deps": "npx tsx scripts/host-script-deps.ts",
    "check:region-coverage": "bash scripts/region-coverage.test.sh",
    "check:emiliaromagna": "bash scripts/emiliaromagna-adapter.test.sh",
    "check:torino": "bash scripts/torino-adapter.test.sh",
    "check:roma": "bash scripts/roma-adapter.test.sh",
    "check:lariofiere": "npx tsx lib/scrapers/lariofiere.ts",
    "check:firenze": "bash scripts/firenze-adapter.test.sh",
    "check:altoadige": "bash scripts/altoadige-adapter.test.sh",
    "check:puglia": "bash scripts/puglia-adapter.test.sh",
    "check:solosagre-national": "bash scripts/solosagre-national.test.sh",
    "check:maintenance-locks": "bash scripts/maintenance-locks.test.sh",
    "check:source-disambiguation": "bash scripts/source-disambiguation.test.sh",
    "check:refresh-lock-single-release": "bash scripts/refresh-lock-single-release.test.sh",
    "check:retention-purge": "bash scripts/retention-purge.test.sh",
    "check:radius-geolocation": "bash scripts/radius-geolocation.test.sh",
    "check:cluster-volume": "bash scripts/cluster-volume.test.sh",
    "check:calendar": "bash scripts/calendar.test.sh",
    "check:event-pages": "bash scripts/event-pages.test.sh",
    "check:user-data": "bash scripts/user-data-gate.test.sh",
    "check:auth-config": "npx tsx scripts/auth-config.test.ts",
    "check:apple": "npx tsx scripts/apple-auth.test.ts",
    "check:auth-flow": "bash scripts/auth-flow.test.sh",
    "check:apple-flow": "bash scripts/dev-db.sh npx tsx scripts/apple-flow.test.ts",
    "check:anon": "bash scripts/anon-public-pages.test.sh",
    "check:auth-deploy": "bash scripts/auth-deploy.test.sh",
    "check:auth-purge": "bash scripts/auth-purge.test.sh",
    "check:backup": "bash scripts/backup.test.sh",
    "check:privacy-pages": "bash scripts/privacy-pages.test.sh",
    "check:saved": "bash scripts/saved.test.sh",
    "check:saved-flow": "bash scripts/saved-flow.test.sh",
    "check:follows": "bash scripts/follows.test.sh",
    "check:follows-flow": "bash scripts/follows-flow.test.sh",
    "check:follows-feed": "bash scripts/follows-feed.test.sh",
    "check:share": "bash scripts/share.test.sh",
    "check:mobile-api": "bash scripts/mobile-api.test.sh",
    "test:ci": "bash scripts/cron-scrape.test.sh && bash scripts/design-tokens.test.sh && npm run check:no-regex-parsing && bash scripts/registry-parity.test.sh && npm run check:navbar && npm run check:restyle && npm run check:crontab-generate && npm run check:connection-limit && npm run check:browser-bundle && npm run check:host-script-deps && npm run check:emiliaromagna && npm run check:puglia && npm run check:altoadige && npm run check:firenze && npm run check:torino && npm run check:roma && npm run check:lariofiere && npm run check:solosagre-national && npm run check:refresh-lock-single-release && npm run check:radius-geolocation && npm run check:calendar && npm run check:auth-config && npm run check:apple && npm run check:auth-deploy && npm run check:privacy-pages && npm run check:saved && npm run check:follows",
    "test:local": "bash scripts/territorial-backfill.test.sh && npm run check:monitoring && npm run check:comuni && bash scripts/dedup.test.sh && bash scripts/category-taxonomy.test.sh && npm run check:region-lock && npm run check:detail-cache && npm run check:region-scoping && npm run check:region-coverage && npm run check:maintenance-locks && npm run check:source-disambiguation && npm run check:cluster-volume && npm run check:retention-purge && npm run check:event-pages && npm run check:user-data && npm run check:auth-flow && npm run check:anon && npm run check:auth-purge && npm run check:backup && npm run check:saved-flow && npm run check:follows-flow && npm run check:follows-feed && npm run check:share && npm run check:apple-flow && npm run check:mobile-api",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "better-auth": "1.7.10",
    "cheerio": "^1.2.0",
    "date-fns": "^4.1.0",
    "domhandler": "^5.0.3",
    "framer-motion": "^12.23.26",
    "he": "^1.2.0",
    "jose": "6.2.12",
    "lucide-react": "^0.562.0",
    "mapbox-gl": "^3.17.0",
    "next": "16.4.1",
    "prisma": "^7.10.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/he": "^1.2.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
