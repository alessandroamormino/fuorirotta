{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "scrape": "npx tsx --import ./lib/scrapers/env.ts lib/scrapers/runner.ts",
    "db:dev:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:dev:down": "docker compose -f docker-compose.dev.yml down",
    "db:dev:push": "bash scripts/dev-db.sh npx prisma db push",
    "db:dev:reset": "docker compose -f docker-compose.dev.yml down -v && npm run db:dev:up && npm run db:dev:push",
    "db:dev:psql": "docker compose -f docker-compose.dev.yml exec postgres-dev psql -U fuorirotta -d fuorirotta_dev",
    "db:dev:sql": "docker compose -f docker-compose.dev.yml exec -T postgres-dev psql -U fuorirotta -d fuorirotta_dev -tAc",
    "dev:local": "bash scripts/dev-db.sh npx next dev",
    "scrape:local": "bash scripts/dev-db.sh npx tsx lib/scrapers/runner.ts",
    "seed:comuni": "bash scripts/dev-db.sh npx tsx scripts/seed-comuni.ts",
    "backfill:territorial": "bash scripts/dev-db.sh npx tsx scripts/backfill-events.ts",
    "backfill:categories": "bash scripts/dev-db.sh npx tsx scripts/backfill-categories.ts",
    "dedup:events": "bash scripts/dev-db.sh npx tsx scripts/dedup-events.ts",
    "test": "bash scripts/cron-scrape.test.sh && bash scripts/design-tokens.test.sh && npm run check:no-regex-parsing && bash scripts/registry-parity.test.sh && bash scripts/territorial-backfill.test.sh && npm run check:monitoring && npm run check:comuni && npm run check:navbar && bash scripts/dedup.test.sh && bash scripts/category-taxonomy.test.sh",
    "check:tokens": "! grep -rInE '#[0-9a-fA-F]{3,8}\\b' app components lib --include='*.ts' --include='*.tsx' --include='*.css' --exclude='globals.css' | grep -vE '&#[0-9]+;|&#x[0-9a-fA-F]+;'",
    "check:no-regex-parsing": "! grep -nE '\\.(match(All)?|exec)\\(/[^/]*(<|class=)|=\\s*/[^/]*(<|class=)' lib/scrapers/solosagre.ts lib/scrapers/inlombardia.ts",
    "check:parity": "bash scripts/registry-parity.test.sh",
    "check:monitoring": "bash scripts/monitoring-endpoint.test.sh",
    "check:territorial": "bash scripts/territorial-backfill.test.sh",
    "check:comuni": "bash scripts/comuni-search.test.sh",
    "check:navbar": "bash scripts/navbar-contracts.test.sh",
    "check:dedup": "bash scripts/dedup.test.sh"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.1.0",
    "@prisma/client": "^6.1.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@tailwindcss/typography": "^0.5.19",
    "@types/leaflet": "^1.9.21",
    "cheerio": "^1.2.0",
    "date-fns": "^4.1.0",
    "domhandler": "^5.0.3",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.23.26",
    "he": "^1.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "mapbox-gl": "^3.17.0",
    "next": "16.1.1",
    "pg": "^8.16.3",
    "prisma": "^6.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/he": "^1.2.3",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
