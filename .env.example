# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=""
DIRECT_URL=""

# Next.js
NEXT_PUBLIC_APP_URL=""

# Mapbox (for map visualization)
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Cron Authentication (required for /api/cron/scrape)
CRON_SECRET=""

# Site URL
NEXT_PUBLIC_SITE_URL=""

# Debug mode (set to "true" to enable verbose logging)
APP_DEBUG="false"

# Helthcheck
HEALTHCHECK_URL=""

# Dead man's switch del job di manutenzione consolidato (backfill/dedup/cache
# cluster, scripts/cron-maintenance.sh). DISTINTO da HEALTHCHECK_URL sopra:
# un check separato con periodo GIORNALIERO, non ogni 4h (D-06).
HEALTHCHECK_MAINTENANCE_URL=""

# Accesso con Google (Fase 21). Con AUTH_ENABLED diverso da true nessuna rotta di
# accesso risponde e nessun segreto serve (interruttore a runtime, D-16).
AUTH_ENABLED=""
# Decide se l'icona della persona esiste nell'HTML: letta dalla BUILD, accenderla
# richiede di ricostruire l'immagine (D-19). Non e' un segreto.
NEXT_PUBLIC_AUTH_ENABLED=""
# Indirizzo pubblico dell'app, es. https://fuori-rotta.it (redirect_uri di Google).
BETTER_AUTH_URL=""
# Segreto di firma delle sessioni, almeno 32 caratteri: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Credenziali OAuth della console Google Cloud.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Accesso con Apple (Fase 25). Interruttore a runtime SEPARATO da AUTH_ENABLED (D-04):
# diverso da true, Apple e' spento anche con tutte le altre variabili presenti.
APPLE_AUTH_ENABLED=""
# Services ID creato nel portale Apple (e' il client_id di OAuth).
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
# Il file .p8 in base64 su UNA riga: base64 < AuthKey_<KEYID>.p8 | tr -d '\n'.
# Va scritto solo sul server (vedi DEPLOYMENT.md), mai in chat ne' nel repository.
APPLE_PRIVATE_KEY_B64=""
# Bundle ID dell'app: suffisso dell'appID nel file di associazione dei link universali
# (/.well-known/apple-app-site-association) e topic delle notifiche push. Vuoto = il file risponde 404
# e il push resta spento.
APPLE_APP_BUNDLE_ID=""

# Soglie della versione dell'app (Fase 26, API-04): interi separati da punto, p.es. 1.4.0. Lette da
# GET /api/v1/config a ogni richiesta; vuote o malformate = nessuno bloccato.
APP_MIN_VERSION=""
APP_RECOMMENDED_VERSION=""

# Notifiche push (Fase 26): vivono SOLO sul server, le legge scripts/send-test-push.sh e le passa per
# nome al suo container usa e getta, MAI al container dell'app. La chiave (il .p8 in base64 su una riga)
# si scrive solo sul server con una lettura nascosta (DEPLOYMENT.md), mai in chat ne' nel repository.
APNS_KEY_ID=""
APNS_PRIVATE_KEY_B64=""

# Backup cifrato giornaliero (Fase 21, D-18, scripts/cron-backup.sh): solo sul
# server, letti dallo script, mai passati al container dell'app.
# Chiave PUBBLICA gpg con cui si cifra (email o impronta); la privata sta sul Mac.
BACKUP_GPG_RECIPIENT=""
# Giorni di conservazione dei backup: e' il numero scritto in /privacy. Vuoto = 14.
BACKUP_RETENTION_DAYS=""
# Destinazione rclone: NON usata (D-21). Lasciare vuoto: i file restano in BACKUP_LOCAL_DIR e il Mac
# li scarica ogni sera nel NAS con scripts/backup-pull.sh.
BACKUP_TARGET=""
# Cartella locale dei backup. Vuoto = /opt/docker/fuori-rotta/backups.
BACKUP_LOCAL_DIR=""
# Immagine con pg_dump, major >= quella del database. Vuoto = postgres:17-alpine.
BACKUP_PG_IMAGE=""
# Dead man's switch del backup: un check separato con periodo giornaliero.
HEALTHCHECK_BACKUP_URL=""
