# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=""
DIRECT_URL=""

# Next.js
NEXT_PUBLIC_APP_URL=""

# Mapbox (for map visualization)
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Cron Authentication (required for /api/cron/scrape)
CRON_SECRET=""

# Site URL
NEXT_PUBLIC_SITE_URL=""

# Debug mode (set to "true" to enable verbose logging)
APP_DEBUG="false"

# Helthcheck
HEALTHCHECK_URL=""

# Dead man's switch del job di manutenzione consolidato (backfill/dedup/cache
# cluster, scripts/cron-maintenance.sh). DISTINTO da HEALTHCHECK_URL sopra:
# un check separato con periodo GIORNALIERO, non ogni 4h (D-06).
HEALTHCHECK_MAINTENANCE_URL=""

# Accesso con Google (Fase 21). Con AUTH_ENABLED diverso da true nessuna rotta di
# accesso risponde e nessun segreto serve (interruttore a runtime, D-16).
AUTH_ENABLED=""
# Decide se l'icona della persona esiste nell'HTML: letta dalla BUILD, accenderla
# richiede di ricostruire l'immagine (D-19). Non e' un segreto.
NEXT_PUBLIC_AUTH_ENABLED=""
# Indirizzo pubblico dell'app, es. https://fuori-rotta.it (redirect_uri di Google).
BETTER_AUTH_URL=""
# Segreto di firma delle sessioni, almeno 32 caratteri: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Credenziali OAuth della console Google Cloud.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Backup cifrato giornaliero (Fase 21, D-18, scripts/cron-backup.sh): solo sul
# server, letti dallo script, mai passati al container dell'app.
# Chiave PUBBLICA gpg con cui si cifra (email o impronta); la privata sta sul Mac.
BACKUP_GPG_RECIPIENT=""
# Giorni di conservazione dei backup: e' il numero scritto in /privacy. Vuoto = 14.
BACKUP_RETENTION_DAYS=""
# Destinazione rclone (es. hetzner:fuorirotta-backups). Vuoto = i file restano in BACKUP_LOCAL_DIR.
BACKUP_TARGET=""
# Cartella locale dei backup. Vuoto = /opt/docker/fuori-rotta/backups.
BACKUP_LOCAL_DIR=""
# Immagine con pg_dump, major >= quella del database. Vuoto = postgres:17-alpine.
BACKUP_PG_IMAGE=""
# Dead man's switch del backup: un check separato con periodo giornaliero.
HEALTHCHECK_BACKUP_URL=""
