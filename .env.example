# Site URL
NEXT_PUBLIC_SITE_URL=""

# Debug mode (set to "true" to enable verbose logging)
APP_DEBUG="false"

# Helthcheck
HEALTHCHECK_URL=""

# Dead man's switch del job di manutenzione consolidato (backfill/dedup/cache
# cluster, scripts/cron-maintenance.sh). DISTINTO da HEALTHCHECK_URL sopra:
# un check separato con periodo GIORNALIERO, non ogni 4h (D-06).
HEALTHCHECK_MAINTENANCE_URL=""

# Accesso con Google (Fase 21). Con AUTH_ENABLED diverso da true nessuna rotta di
# accesso risponde e nessun segreto serve (interruttore a runtime, D-16).
AUTH_ENABLED=""
# Decide se l'icona della persona esiste nell'HTML: letta dalla BUILD, accenderla
# richiede di ricostruire l'immagine (D-19). Non e' un segreto.
NEXT_PUBLIC_AUTH_ENABLED=""
# Indirizzo pubblico dell'app, es. https://fuori-rotta.it (redirect_uri di Google).
BETTER_AUTH_URL=""
# Segreto di firma delle sessioni, almeno 32 caratteri: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Credenziali OAuth della console Google Cloud.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
